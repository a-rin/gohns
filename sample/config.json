{
  "Title": "gohns sample diary",
  "UserMail": "<メールアドレス>",
  "Auther": "<著者名>",
  "DiaryDir": "diary",
  "DiaryCode": "UTF-8",
  "MyDiaryURI": "<日記の URL>",
  "Theme": "ice",
  "DefaultMax": 5,
  "DefaultTitleMax": 30,
  "CacheDir": "<キャッシュ用ディレクトリ>",
  "LogDir": "<ログ用ディレクトリ>",
  "StartYear": 2023,
  "RecentReverse": true,
  "YMDReverse": true,
  "RecentTitleReverse": true,
  "YMDTitleReverse": true,
  "FNCountStyle": true,
  "Style": {
    "CalendarUse": false
  },
  "PIM": {
    "Style": {},
    "Schedule": {}
  },
  "HtmlSeq": [
    "Head1",
    [
      "StaticFile",
      "ice/headincl.txt"
    ],
    "Head2",
    "OpenBody",
    "Header",
    "Diaries",
    [
      "StaticFile",
      "ice/foot.txt"
    ],
    "Footer",
    "CloseBody"
  ],
  "Tmpl": {
    "DocType": "<!DOCTYPE HTML>\n",
    "Head1": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\">\n<meta name=\"robots\" content=\"noindex, nofollow\" />\n{{{StyleSheet}}}<title>{{Title}}</title>\n",
    "Head2": "</head>\n",
    "OpenBody": "<body>\n<div class=\"container\">\n",
    "CloseBody": "<hr>{{procTime}}<br>\n</div><!-- class container -->\n</body>\n</html>\n",
    "Title": "<h1>{{Title}}</h1>\n<p align=\"right\">Powered by gohns (Go HNF Renderer)</p>\n",
    "Footer": "",
    "OpenDiaries": "<div class=\"row\"><div class=\"col-md-8\">",
    "CloseDiaries": "以上、{{dateCnt}}日分です。<br>\n</div><!-- col-md-8 -->\n</div><!--row-->\n",
    "Ok": "",
    "New": "<h3 class=\"h3new\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}\">§</a>{{#catsOn}}{{#cats}}[<a href=\"?title&CAT={{.}}\">{{.}}</a>]{{/cats}} {{/catsOn}}{{sec}}</h3>\n",
    "LNew": "<h3 class=\"h3new\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}\">§</a>{{#catsOn}}{{#cats}}[<a href=\"?title&CAT={{.}}\">{{.}}</a>]{{/cats}} {{/catsOn}}<a href=\"{{{uri}}}\">{{sec}}</a></h3>\n",
    "Sub": "<h4 class=\"h4sub\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a>{{subsec}}</h4>\n",
    "LSub": "<h4 class=\"h4sub\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a><a href=\"{{{uri}}}\">{{subsec}}</a></h4>\n",
    "Text": "{{text}}\n",
    "TextLn": "{{text}}<br>\n",
    "OpenDate": "<h2 class=\"date\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}0\" name=\"{{year}}{{month}}{{day}}0\">□</a>{{year}}/{{month}}/{{day}}\n</h2>\n<div class=\"datebody\">\n",
    "CloseDate": "</div><!-- class datebody -->\n<br>\n",
    "OpenSec": "<div class=\"section\">\n",
    "CloseSec": "</div><!-- class section -->\n",
    "OpenSub": "<div class=\"sub\">\n",
    "CloseSub": "</div><!-- class subsec -->\n",
    "Link": "<a href=\"{{{uri}}}\">{{text}}</a>\n",
    "P": "<P>\n",
    "_P": "<_P>\n",
    "Cite": "<cite>\n",
    "_Cite": "</cite>\n",
    "Pre": "<pre>\n",
    "_Pre": "</pre>\n",
    "Ul": "<ul>\n",
    "_Ul": "</ul>\n",
    "Ol": "<ol>\n",
    "_Ol": "</ol>\n",
    "Li": "<li>{{text}}\n",
    "Dl": "<dl>\n",
    "_Dl": "</dl>\n",
    "Dt": "<dt>{{text}}</dt>\n",
    "Dd": "<dd>{{text}}</dd>\n",
    "Div": "<div classname=\"{{text}}\">\n",
    "_Div": "</div>\n",
    "Strong": "<strong>{{text}}</strong>",
    "Span": "<span classname=\"{{class}}\">{{text}}</span>\n",
    "Strike": "<strike>{{text}}</strike>\n",
    "LStrike": "<a href=\"{{{uri}}}\"><strike>{{text}}</strike></a>\n",
    "Comment": "<!--{{text}}-->\n",
    "Fn": "<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}F{{fnno}}\"><sup>*{{fnno}}</sup></a>",
    "FnProcOpen": "<hr><div class=\"fn\">\n",
    "FnProcClose": "</div><!-- fn -->\n",
    "FnProc": "<a name=\"{{year}}{{month}}{{day}}{{secno}}F{{fnno}}\" href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}F{{fnno}}\">*{{fnno}}</a>:{{{text}}}<br>\n",
    "Img": "<img src=\"{{{imgURI}}}\" alt=\"{{text}}\" border=\"2\">",
    "LImg": "<a href=\"{{{uri}}}\"><img src=\"{{{imgURI}}}\" alt=\"{{text}}\" border=\"2\"></a>",
    "Ads": ""
  },
  "TitleHtmlSeq": [
    "Head1",
    "Head2",
    "OpenBody",
    "Header",
    "Diaries",
    "Footer",
    "CloseBody"
  ],
  "TitleTmpl": {
    "DocType": "<!DOCTYPE HTML>\n",
    "Head": "<html><head>\n<meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\">\n{{{StyleSheet}}}<title>{{Title}} Title list</title>\n</head>\n",
    "OpenBody": "<body>\n<div class=\"container\">\n",
    "CloseBody": "<hr>{{procTime}}msec<br>\n</div><!-- class container -->\n</body>\n</html>\n",
    "Title": "<h1>{{Title}} Title list</h1>\n<p align=\"right\">Powered by gohns (Go HNF Renderer)</p>\n",
    "Footer": "",
    "OpenDiaries": "<div class=\"row\">\n",
    "CloseDiaries": "</div>\n",
    "Ok": "",
    "New": "<div class=\"span10\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}\">{{year}}/{{month}}/{{day}}§{{secno}}</a>: {{sec}}</div>\n",
    "LNew": "<div class=\"span10\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}\">{{year}}/{{month}}/{{day}}§{{secno}}</a>: <a href=\"{{{uri}}}\">{{sec}}</a></div>\n",
    "Sub": "<div class=\"span9 offset1\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a>{{subsec}}</div>\n",
    "LSub": "<div class=\"span9 offset1\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" name=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a><a href=\"{{{uri}}}\">{{subsec}}</a></div>\n",
    "Strong": ""
  }
}
