{
  "Title": "gohns sample diary",
  "UserMail": "<メールアドレス>",
  "Auther": "<著者名>",
  "DiaryDir": "diary",
  "DiaryCode": "UTF-8",
  "MyDiaryURI": "<日記の URL>",
  "Theme": "ice",
  "DefaultMax": 5,
  "DefaultTitleMax": 30,
  "CacheDir": "<キャッシュ用ディレクトリ>",
  "LogDir": "<ログ用ディレクトリ>",
  "StartYear": 2023,
  "RecentReverse": true,
  "YMDReverse": true,
  "RecentTitleReverse": true,
  "YMDTitleReverse": true,
  "FNCountStyle": true,
  "Style": {
    "CalendarUse": false
  },
  "PIM": {
    "Style": {},
    "Schedule": {}
  },
  "HtmlSeq": [
    "Head1",
    [
      "StaticFile",
      "ice/headincl.txt"
    ],
    "Head2",
    "OpenBody",
    "Header",
    "Diaries",
    [
      "StaticFile",
      "ice/foot.txt"
    ],
    "Footer",
    "CloseBody"
  ],
  "Tmpl": {
    "DocType": "<!DOCTYPE html>\n",
    "Head1": "<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<title>{{Title}}</title>\n",
    "Head2": "</head>\n",
    "OpenBody": "<body>\n<div class=\"container\">\n",
    "CloseBody": "<hr>{{procTime}}<br>\n</div><!-- class container -->\n</body>\n</html>\n",
    "Title": "<header>\n<h1>{{Title}}</h1>\n<p>Powered by gohns (Go HNF Renderer)</p>\n</header>\n",
    "Footer": "",
    "OpenDiaries": "<main>\n",
    "CloseDiaries": "<p>以上、{{dateCnt}}日分です。</p>\n</main>\n",
    "Ok": "",
    "New": "<h3 class=\"h3new\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}\">§</a>{{#catsOn}}{{#cats}}[<a href=\"?title&CAT={{.}}\">{{.}}</a>]{{/cats}} {{/catsOn}}{{sec}}</h3>\n",
    "LNew": "<h3 class=\"h3new\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}\">§</a>{{#catsOn}}{{#cats}}[<a href=\"?title&CAT={{.}}\">{{.}}</a>]{{/cats}} {{/catsOn}}<a href=\"{{{uri}}}\">{{sec}}</a></h3>\n",
    "Sub": "<h4 class=\"h4sub\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a>{{subsec}}</h4>\n",
    "LSub": "<h4 class=\"h4sub\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a><a href=\"{{{uri}}}\">{{subsec}}</a></h4>\n",
    "Text": "{{text}}\n",
    "TextLn": "{{text}}<br>\n",
    "OpenDate": "<h2 class=\"date\">\n<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}0\" id=\"{{year}}{{month}}{{day}}0\">□</a>{{year}}/{{month}}/{{day}}\n</h2>\n<div class=\"datebody\">\n",
    "CloseDate": "</div><!-- class datebody -->\n<br>\n",
    "OpenSec": "<div class=\"section\">\n",
    "CloseSec": "</div><!-- class section -->\n",
    "OpenSub": "<div class=\"sub\">\n",
    "CloseSub": "</div><!-- class subsec -->\n",
    "Link": "<a href=\"{{{uri}}}\">{{text}}</a>\n",
    "Url": "<a href=\"{{{uri}}}\">{{text}}({{uri}})</a>\n",
    "P": "<p>\n",
    "_P": "</p>\n",
    "Cite": "<cite>\n",
    "_Cite": "</cite>\n",
    "Pre": "<pre>\n",
    "_Pre": "</pre>\n",
    "Ul": "<ul>\n",
    "_Ul": "</ul>\n",
    "Ol": "<ol>\n",
    "_Ol": "</ol>\n",
    "Li": "<li>{{text}}\n",
    "Dl": "<dl>\n",
    "_Dl": "</dl>\n",
    "Dt": "<dt>{{text}}</dt>\n",
    "Dd": "<dd>{{text}}</dd>\n",
    "Div": "<div class=\"{{text}}\">\n",
    "_Div": "</div>\n",
    "Strong": "<strong>{{text}}</strong>",
    "Span": "<span class=\"{{class}}\">{{text}}</span>\n",
    "Strike": "<s>{{text}}</s>\n",
    "LStrike": "<a href=\"{{{uri}}}\"><s>{{text}}</s></a>\n",
    "Comment": "<!--{{text}}-->\n",
    "Fn": "<a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}F{{fnno}}\"><sup>*{{fnno}}</sup></a>",
    "FnProcOpen": "<hr><div class=\"fn\">\n",
    "FnProcClose": "</div><!-- fn -->\n",
    "FnProc": "<a id=\"{{year}}{{month}}{{day}}{{secno}}F{{fnno}}\" href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}F{{fnno}}\">*{{fnno}}</a>:{{{text}}}<br>\n",
    "Img": "<img src=\"{{{imgURI}}}\" alt=\"{{text}}\"{{#align}} class=\"align-{{align}}\"{{/align}}>",
    "LImg": "<a href=\"{{{uri}}}\"><img src=\"{{{imgURI}}}\" alt=\"{{text}}\"{{#align}} class=\"align-{{align}}\"{{/align}}></a>",
    "Ads": ""
  },
  "TitleHtmlSeq": [
    "Head1",
    [
      "StaticFile",
      "ice/headincl.txt"
    ],
    "Head2",
    "OpenBody",
    "Header",
    "Diaries",
    "Footer",
    "CloseBody"
  ],
  "TitleTmpl": {
    "DocType": "<!DOCTYPE html>\n",
    "OpenBody": "<body>\n<div class=\"container\">\n",
    "CloseBody": "<hr>{{procTime}}msec<br>\n</div><!-- class container -->\n</body>\n</html>\n",
    "Title": "<header>\n<h1>{{Title}} Title list</h1>\n<p>Powered by gohns (Go HNF Renderer)</p>\n</header>\n",
    "Footer": "",
    "OpenDiaries": "<main>\n",
    "CloseDiaries": "</main>\n",
    "Ok": "",
    "New": "<div class=\"entry\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}\">{{year}}/{{month}}/{{day}}§{{secno}}</a>: {{sec}}</div>\n",
    "LNew": "<div class=\"entry\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}\">{{year}}/{{month}}/{{day}}§{{secno}}</a>: <a href=\"{{{uri}}}\">{{sec}}</a></div>\n",
    "Sub": "<div class=\"subentry\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a>{{subsec}}</div>\n",
    "LSub": "<div class=\"subentry\"><a href=\"?{{year}}{{month}}#{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\" id=\"{{year}}{{month}}{{day}}{{secno}}S{{subsecno}}\">・</a><a href=\"{{{uri}}}\">{{subsec}}</a></div>\n",
    "Strong": "",
    "Head1": "<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<title>{{Title}} Title list</title>\n",
    "Head2": "</head>\n"
  }
}
